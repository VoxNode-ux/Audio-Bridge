 <?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup / device transfer of app data — this is a private, local-only tool. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
 