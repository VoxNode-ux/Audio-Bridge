<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking: raw UDP/TCP sockets between phone and tablet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AudioRecord.Builder() is annotated @RequiresPermission(RECORD_AUDIO) at the API
         level regardless of capture source, so this is required even though playback
         capture's actual user consent comes from the MediaProjection screen-capture
         dialog, not a mic permission prompt. Sender-only; the receiver role never
         triggers this path. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- mDNS discovery (NsdManager) needs coarse location on some OEM/Android versions -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_MULTICAST_STATE" />

    <!-- WiFi Direct -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!-- Wi-Fi Direct peer discovery (WifiP2pManager.discoverPeers) requires this on
         Android 10-12 (API 29-32) — NEARBY_WIFI_DEVICES above was only introduced in,
         and only covers P2P discovery starting on, API 33. Capped with maxSdkVersion
         so it's a no-op (and never shown to the user) on API 33+ devices, which are
         already covered by the narrower NEARBY_WIFI_DEVICES grant instead.
         ACCESS_COARSE_LOCATION is required alongside FINE per Android 12+ policy
         (lint's CoarseFineLocation check) — same maxSdkVersion cap, since it exists
         only to satisfy that pairing rule for the same API 29-32 window. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Bluetooth. minSdk is 29, so in principle this app could land on an API 29-30
         device even though neither of your actual devices is one — both the Moto (API
         36) and Lenovo Tab (API 33) are well past 31, where BLUETOOTH_CONNECT/SCAN take
         over. The legacy pair below only activates on that older 29-30 range. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />

    <!-- System audio capture (AudioPlaybackCaptureConfiguration, API 29+) requires a
         foreground service of type mediaProjection while actively capturing. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keep CPU/network awake while streaming so the tablet doesn't drop the connection -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AudioBridge"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.AudioBridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sender role needs "mediaProjection" (system audio capture requires this type
             on Android 14+ or startForeground() throws SecurityException); receiver role
             uses "mediaPlayback" for plain AudioTrack output. Both are declared here since
             one service instance handles either role depending on user selection. -->
        <service
            android:name=".audio.AudioStreamService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|mediaProjection" />

    </application>

</manifest>
 